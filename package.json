{
	"name": "cleanx",
	"description": "A quieter X. Hide videos, images, and GIFs with a click.",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"packageManager": "pnpm@10.28.1",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "wxt",
		"build": "wxt build",
		"build:e2e": "pnpm build",
		"zip": "wxt zip",
		"compile": "tsc --noEmit",
		"lint": "biome lint .",
		"format": "biome format . --write",
		"icons:generate": "node scripts/generate-icons.mjs",
		"quality": "pnpm compile && pnpm lint",
		"smoke": "pnpm build && node scripts/smoke.mjs",
		"package": "pnpm zip && node scripts/smoke.mjs",
		"postinstall": "wxt prepare",
		"test": "vitest run --coverage",
		"test:watch": "vitest",
		"test:e2e": "pnpm build:e2e && playwright test"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.6",
		"@playwright/test": "1.58.2",
		"@types/chrome": "0.1.37",
		"@types/node": "22.19.15",
		"@vitest/coverage-v8": "2.1.9",
		"jsdom": "24.1.3",
		"typescript": "5.9.3",
		"vitest": "2.1.9",
		"wxt": "0.20.18"
	}
}
